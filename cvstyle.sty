\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cvstyle}[2026/10/28 Word CV layout]
\RequirePackage[letterpaper,top=1in,bottom=1in,left=1.0733in,right=1.0733in,
  headheight=14pt,headsep=23pt]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{fix-cm}
\RequirePackage{newtxtext}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{needspace}
\RequirePackage[normalem]{ulem}
\RequirePackage{xcolor}
\RequirePackage[numbers]{natbib}
\RequirePackage{bibentry}
\RequirePackage{hyperref}
\hypersetup{colorlinks=true,urlcolor=blue,linkcolor=black,
  pdftitle={Yang Zhao Curriculum Vitae},pdfauthor={Yang Zhao}}
\urlstyle{same}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[R]{\normalfont\small Page \thepage\ of \pageref*{LastPage}}
\renewcommand{\headrulewidth}{0pt}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{1em}
\raggedright
\raggedbottom
\AtBeginDocument{\fontsize{11bp}{14.4bp}\selectfont}
\setlist[itemize]{leftmargin=0.5in,labelsep=0.18in,topsep=0pt,
  itemsep=0pt,parsep=0pt,partopsep=0pt,label=\textbullet}
\newcommand{\cvsection}[1]{%
  \par\addvspace{9pt}\Needspace{4\baselineskip}%
  {\fontsize{13}{15}\selectfont\bfseries #1\par}%
  \vspace{2pt}\hrule height 0.8pt\relax\vspace{6pt}}
\newcommand{\cvrow}[2]{%
  \noindent\begin{tabular*}{\linewidth}{@{}l@{\extracolsep{\fill}}r@{}}%
    #1 & #2\\
  \end{tabular*}\par}
\newcommand{\cventryspace}{\par\addvspace{9pt}\Needspace{3\baselineskip}}
\newcommand{\cvproject}[1]{\par\Needspace{2\baselineskip}#1\par}
\newcommand{\cvpublication}[1]{%
  {\fontsize{11bp}{12.7bp}\selectfont\bibentry{#1}.\par}\addvspace{9pt}}

% The content file supplies only contact text; header formatting lives here.
\newcommand{\cvheader}[3]{%
  \begin{center}
    {\fontsize{20}{23}\selectfont\bfseries #1\par}
    \vspace{3pt}
    {\fontsize{10}{12}\selectfont #2 | %
      \href{#3}{\uline{Personal Website}}\par}
  \end{center}
  \vspace{-8pt}}
% Keep the work heading and its entry together as in the verified layout.
\newcommand{\cvworksection}[1]{%
  \Needspace{15\baselineskip}\cvsection{#1}}

% Load BibTeX records without printing a separate reference list.
\AtBeginDocument{\bibliographystyle{cvpublications}\nobibliography{publications}}
