\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cvstyle}[2026/10/28 Word CV layout]
\RequirePackage[letterpaper,top=1in,bottom=1in,left=1.0733in,right=1.0733in,
  headheight=14pt,headsep=23pt]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{fix-cm}
\RequirePackage{newtxtext}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{needspace}
\RequirePackage[normalem]{ulem}
\RequirePackage{xcolor}
\RequirePackage[numbers]{natbib}
\RequirePackage{bibentry}
\RequirePackage{hyperref}
\hypersetup{colorlinks=true,urlcolor=blue,linkcolor=black,
  pdftitle={Yang Zhao Curriculum Vitae},pdfauthor={Yang Zhao}}
\urlstyle{same}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[R]{\normalfont\small Page \thepage\ of \pageref*{LastPage}}
\renewcommand{\headrulewidth}{0pt}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{1em}
\raggedright
\raggedbottom
\AtBeginDocument{\fontsize{11bp}{14.4bp}\selectfont}
\setlist[itemize]{leftmargin=0.5in,labelsep=0.18in,topsep=0pt,
  itemsep=0pt,parsep=0pt,partopsep=0pt,label=\textbullet}
\newcommand{\cvsection}[1]{%
  \par\addvspace{9pt}\Needspace{4\baselineskip}%
  {\fontsize{13}{15}\selectfont\bfseries #1\par}%
  \vspace{2pt}\nointerlineskip\moveleft5.28bp\vbox{\hrule width\dimexpr\linewidth+10.56bp\relax height1bp}\nointerlineskip\vspace{6pt}}
\newcommand{\cvrow}[2]{%
  \noindent\begin{tabular*}{\linewidth}{@{}l@{\extracolsep{\fill}}r@{}}%
    #1 & #2\\
  \end{tabular*}\par}
\newcommand{\cventryspace}{\par\addvspace{9pt}\Needspace{3\baselineskip}}
\newcommand{\cvproject}[1]{\par\Needspace{2\baselineskip}\hspace*{11bp}#1\par}
\newcommand{\cvpublication}[1]{%
  \cvpublicationtext{12.65}{\bibentry{#1}.}\addvspace{9.2bp}}

% The content file supplies only contact text; header formatting lives here.
\newcommand{\cvheader}[3]{%
  \begin{center}
    {\fontsize{20}{23}\selectfont\bfseries #1\par}
    \vspace{3pt}
    {\fontsize{10}{12}\selectfont #2 | %
      \href{#3}{\uline{Personal Website}}\par}
  \end{center}
  \vspace{-8pt}}
% Keep the work heading and its entry together as in the verified layout.
\newcommand{\cvworksection}[1]{%
  \Needspace{15\baselineskip}\cvsection{#1}}

% Load BibTeX records without printing a separate reference list.
\AtBeginDocument{\bibliographystyle{IEEEtran}\cvbstcontrol\nobibliography{publications}}

% IEEE-formatted references retain the CV’s unnumbered layout and name emphasis.
\newcommand{\cvpublicationtext}[2]{%
  {\fontsize{11bp}{#1bp}\selectfont\interlinepenalty=10000 #2\par}}
\newcommand{\cvpublicationsection}[1]{%
  \par\addvspace{16bp}\cvsection{#1}\vspace{6bp}}

% Research roles follow advisors on their own line in the Word CV.
\newcommand{\cvresearchdetails}[2]{\textit{#1}\par\textit{#2}\par}

% IEEEtran passes each formatted author name through this command.
% Bold the CV owner and retain Jeon’s author-supplied citation spelling.
\newcommand{\cvAuthor}[1]{%
  \ifstrequal{#1}{Y.~Zhao}{\textbf{#1}}{%
    \ifstrequal{#1}{J.~h. Jeon}{J.~hwan Jeon}{#1}}}

% Style-control entries configure BibTeX but are not rendered citations.
\newcommand{\cvbstcontrol}{%
  \immediate\write\@auxout{\string\citation{cv:control}}}
